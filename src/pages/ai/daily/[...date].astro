---
import { getCollection, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { removeFileExtension, url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const briefs = await getCollection("aiBriefs");
	return briefs.map((entry) => ({
		params: { date: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateText = entry.data.date.toISOString().slice(0, 10);
---

<MainGridLayout title={entry.data.title} description={entry.data.summary}>
	<article class="card-base px-7 md:px-9 py-7" data-pagefind-body>
		<a href={url("/ai/daily/")} class="inline-flex items-center gap-1 text-sm text-50 hover:text-(--primary) mb-5">
			<Icon name="material-symbols:arrow-back-rounded" />
			<span>AI Intelligence Daily</span>
		</a>
		<div class="text-xs font-semibold text-(--primary) mb-2">{dateText}</div>
		<h1 data-pagefind-meta="title" class="text-3xl font-bold text-90 mb-3">{entry.data.title}</h1>
		<p class="text-50 leading-7 mb-5">{entry.data.summary}</p>
		<div class="flex flex-wrap gap-2 mb-7">
			{entry.data.tags.map((tag) => <span class="text-xs rounded-full bg-(--primary)/10 text-(--primary) px-3 py-1">#{tag}</span>)}
		</div>
		<Markdown class="">
			<Content />
		</Markdown>
	</article>
</MainGridLayout>
